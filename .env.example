# Copy to .env (git-ignored). Everything is optional for local runs.
TYPESAFE_API_KEY=            # Jev (TypeSafe). Empty => deterministic review rule only.
# Operator API login (Authorization: Bearer <token>). Leave BOTH empty to run with auth off (local dev only).
OPERATOR_TOKEN=              # approve / reject / manual allocation / cancel
ADMIN_TOKEN=                 # + simulator control, crisis & fault injection, policy settings
SIMULATION_SPEED=8           # ticks/sec while RUNNING
TICK_MINUTES=15
SIMULATOR_START_MODE=paused  # paused | running

# OpenTelemetry: compose already points the backend at its bundled collector, so tracing is
# ON by default with `docker compose up` (Jaeger UI http://localhost:16686). To turn it OFF,
# override the endpoint to empty, e.g.: OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# GenAI assistant: Next.js server routes under /ai (frontend container).
# With no OPENAI_API_KEY the frontend answers with a built-in mock model, so the UI always works.
OPENAI_API_KEY=
# OPENAI_BASE_URL=           # optional OpenAI-compatible gateway
LLM_MODEL=gpt-6-luna         # model id the AI SDK asks for
# AI_MOCK=1                  # force the mock model even when a key is set
