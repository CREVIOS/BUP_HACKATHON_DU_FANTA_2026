{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["alb", "argocd", "grafana"],
  "properties": {
    "alb": {
      "type": "object",
      "required": ["certificateARNs"],
      "properties": {
        "certificateARNs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^arn:[a-z0-9-]+:acm:[a-z0-9-]+:[0-9]{12}:certificate/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "grafana": {
      "type": "object",
      "required": ["ingress"],
      "properties": {
        "ingress": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "argocd": {
      "type": "object",
      "required": ["ingress"],
      "properties": {
        "ingress": {
          "type": "object",
          "required": ["enabled", "hostname"],
          "properties": {
            "enabled": { "type": "boolean" },
            "hostname": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        }
      }
    }
  }
}
